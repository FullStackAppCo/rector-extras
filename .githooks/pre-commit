#!/usr/bin/env bash
#
# Pre-commit hook.
#
# Runs static analysis, refactoring, and formatting against the PHP files that
# are staged for commit — changed files only — using `herd composer`.
#
# Enable with: git config core.hooksPath .githooks (composer install does this).

set -euo pipefail

# Collect staged PHP files (Added, Copied, Modified — deletions are skipped).
STAGED_FILES=()
while IFS= read -r file; do
    STAGED_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.php')

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

echo "→ refactor (${#STAGED_FILES[@]} changed PHP file(s))"
composer refactor -- "${STAGED_FILES[@]}"

echo "→ format"
composer format -- "${STAGED_FILES[@]}"

# Re-stage anything Rector or Pint rewrote so the fixes are part of the commit
# and analyze sees the final code.
git add -- "${STAGED_FILES[@]}"

echo "→ analyze"
composer analyze

composer dump-autoload --strict-psr --optimize --dry-run