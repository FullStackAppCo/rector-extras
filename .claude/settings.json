{
  "permissions": {
    "allow": [
      "Bash(composer analyse:*)",
      "Bash(composer format:*)",
      "Bash(composer refactor:*)",
      "Bash(composer test:*)",
      "Bash(find:*)",
      "Bash(gh pr create:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch)",
      "Bash(git branch -m)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit)",
      "Bash(git commit -m)",
      "Bash(git push)",
      "Bash(git push -u)",
      "Bash(ls:*)",
      "Bash(tree:*)"
